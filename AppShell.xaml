<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="MicroAssur.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:MicroAssur.Views"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{StaticResource PageBackground}"
       Shell.TitleColor="{StaticResource TextDark}"
       Shell.ForegroundColor="{StaticResource Primary}"
       Shell.NavBarHasShadow="False"
       Shell.TabBarBackgroundColor="White"
       Shell.TabBarForegroundColor="{StaticResource Primary}"
       Shell.TabBarTitleColor="{StaticResource Primary}"
       Shell.TabBarUnselectedColor="#6F9BCB">

    <!-- 01 - Accueil (écran de bienvenue) -->
    <ShellContent Route="splash" ContentTemplate="{DataTemplate views:SplashPage}" />

    <!-- Navigation principale -->
    <TabBar Route="main">
        <ShellContent Title="Accueil" Icon="ic_home.png" Route="home"
                      ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Title="Contrats" Icon="ic_contracts.png" Route="contracts"
                      ContentTemplate="{DataTemplate views:ContractsPage}" />
        <ShellContent Title="Souscription" Icon="ic_shield.png" Route="catalog"
                      ContentTemplate="{DataTemplate views:CatalogPage}" />
        <ShellContent Title="Profil" Icon="ic_profile.png" Route="profile"
                      ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>

</Shell>
