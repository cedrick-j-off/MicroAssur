<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MicroAssur.Views.CatalogPage"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="12">
            <Label Text="Nos couvertures" Style="{StaticResource PageTitle}" />
            <Label Text="Choisissez la catégorie qui vous intéresse." FontSize="20" Margin="0,0,0,6" />

            <VerticalStackLayout x:Name="categoriesLayout" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0"
                                        BackgroundColor="{Binding Tint}" StrokeShape="RoundRectangle 22" VerticalOptions="Center">
                                    <Image Source="{Binding Icon}" WidthRequest="22" HeightRequest="22"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="17" />
                                    <Label Text="{Binding Description}" FontSize="14" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="26"
                                       TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
