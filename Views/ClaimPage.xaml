<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MicroAssur.Views.ClaimPage"
             Title="Déclarer un sinistre"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto" Padding="20,8,20,20" RowSpacing="14">

        <!-- Indicateur d'étapes -->
        <Grid ColumnDefinitions="*,*,*,*">
            <BoxView Grid.ColumnSpan="4" HeightRequest="2" Color="{StaticResource CardBorder}" VerticalOptions="Start" Margin="45,14,45,0" />
            <VerticalStackLayout Grid.Column="0" Spacing="4">
                <Border x:Name="c1" WidthRequest="30" HeightRequest="30" StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="0" HorizontalOptions="Center">
                    <Label x:Name="n1" Text="1" TextColor="White" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label x:Name="l1" Text="Informations" FontSize="11" HorizontalOptions="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="4">
                <Border x:Name="c2" WidthRequest="30" HeightRequest="30" StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="0" HorizontalOptions="Center">
                    <Label x:Name="n2" Text="2" TextColor="White" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label x:Name="l2" Text="Détails" FontSize="11" HorizontalOptions="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="4">
                <Border x:Name="c3" WidthRequest="30" HeightRequest="30" StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="0" HorizontalOptions="Center">
                    <Label x:Name="n3" Text="3" TextColor="White" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label x:Name="l3" Text="Pièces" FontSize="11" HorizontalOptions="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="3" Spacing="4">
                <Border x:Name="c4" WidthRequest="30" HeightRequest="30" StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="0" HorizontalOptions="Center">
                    <Label x:Name="n4" Text="4" TextColor="White" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label x:Name="l4" Text="Confirmation" FontSize="11" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="8">

                <!-- Étape 1 : Informations -->
                <VerticalStackLayout x:Name="panel1" Spacing="8">
                    <Label Text="Type de sinistre" FontSize="17" />
                    <Border Style="{StaticResource Field}" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Picker x:Name="typePicker" Title="Choisir un type" />
                            <Label Grid.Column="1" Text="⌄" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center" InputTransparent="True" />
                        </Grid>
                    </Border>

                    <Label Text="Date du sinistre" FontSize="17" />
                    <Border Style="{StaticResource Field}" Margin="0,0,0,8">
                        <DatePicker x:Name="datePicker" Format="dd/MM/yyyy" />
                    </Border>

                    <Label Text="Description" FontSize="17" />
                    <Border Style="{StaticResource Field}" Padding="8,4">
                        <Editor x:Name="descEditor" HeightRequest="120" Placeholder="Décrivez brièvement ce qui s’est passé..." />
                    </Border>
                </VerticalStackLayout>

                <!-- Étape 2 : Détails -->
                <VerticalStackLayout x:Name="panel2" Spacing="8" IsVisible="False">
                    <Label Text="Lieu du sinistre" FontSize="17" />
                    <Border Style="{StaticResource Field}" Margin="0,0,0,8">
                        <Entry x:Name="placeEntry" Placeholder="Ville, quartier, carrefour..." />
                    </Border>
                    <Label Text="Estimation des dommages (FCFA)" FontSize="17" />
                    <Border Style="{StaticResource Field}">
                        <Entry x:Name="estimateEntry" Placeholder="Ex. 150000" Keyboard="Numeric" />
                    </Border>
                </VerticalStackLayout>

                <!-- Étape 3 : Pièces -->
                <VerticalStackLayout x:Name="panel3" Spacing="10" IsVisible="False">
                    <Label Text="Pièces justificatives" Style="{StaticResource SectionTitle}" />
                    <Label Text="Ajoutez des photos ou documents (constat, certificat médical, photos des dégâts)." Style="{StaticResource Muted}" />
                    <Button Text="Ajouter une photo ou un document" Style="{StaticResource OutlineButton}" Clicked="OnAddFile" />
                    <VerticalStackLayout x:Name="filesLayout" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12,10">
                                    <Label Text="{Binding .}" FontSize="15" LineBreakMode="MiddleTruncation" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Étape 4 : Confirmation -->
                <VerticalStackLayout x:Name="panel4" Spacing="10" IsVisible="False">
                    <Label Text="Vérifiez votre déclaration" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Padding="16">
                        <Label x:Name="recapLabel" FontSize="16" LineHeight="1.3" />
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Button x:Name="backButton" Text="Précédent" Style="{StaticResource OutlineButton}" IsVisible="False" Clicked="OnBack" />
            <Button x:Name="nextButton" Text="Suivant" Style="{StaticResource PrimaryButton}" Clicked="OnNext" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
