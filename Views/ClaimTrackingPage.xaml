<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MicroAssur.Views.ClaimTrackingPage"
             Title="Suivi de votre dossier">
    <Grid RowDefinitions="*,Auto" Padding="20,8,20,20">
        <ScrollView>
            <VerticalStackLayout Spacing="18">
                <Border BackgroundColor="{StaticResource Chip}" StrokeThickness="0" Padding="14" StrokeShape="RoundRectangle 16">
                    <Grid ColumnDefinitions="44,*" ColumnSpacing="10">
                        <Image Source="ic_shield.png" WidthRequest="30" HeightRequest="30" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="claimNumber" FontAttributes="Bold" FontSize="17" />
                            <Label x:Name="claimCategory" FontSize="16" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout x:Name="stepsLayout" Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="42,*" ColumnSpacing="8">
                                <BoxView WidthRequest="2" Color="#BFD6EE" HorizontalOptions="Center"
                                         VerticalOptions="Fill" Margin="0,30,0,0" IsVisible="{Binding ShowLine}" />
                                <Border WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                        BackgroundColor="{Binding CircleBg}" VerticalOptions="Start" HorizontalOptions="Center" Padding="0">
                                    <Label Text="{Binding Glyph}" TextColor="{Binding GlyphColor}" FontSize="16" FontAttributes="Bold"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Padding="0,2,0,28" Spacing="3">
                                    <Label Text="{Binding Title}" TextColor="{Binding TitleColor}"
                                           FontAttributes="{Binding TitleWeight}" FontSize="19" />
                                    <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="16" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="1" Text="Voir l’indemnisation" Style="{StaticResource PrimaryButton}" Clicked="OnCompensation" />
    </Grid>
</ContentPage>
