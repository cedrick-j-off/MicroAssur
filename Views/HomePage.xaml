<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MicroAssur.Views.HomePage"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20,20" Spacing="14">
            <Border Background="{StaticResource PrimaryGradient}" StrokeThickness="0"
                    Padding="18,18" StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="8">
                    <Label Text="MICROASSUR" FontSize="12" FontAttributes="Bold"
                           TextColor="#DCEAFF" CharacterSpacing="1.5" />
                    <Label x:Name="greeting" FontSize="26" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Votre protection, simplement."
                           FontSize="16" TextColor="White" Opacity="0.9" />
                </VerticalStackLayout>
            </Border>
            <Label Text="Que souhaitez-vous faire aujourd’hui ?" FontSize="18"
                   FontAttributes="Bold" Margin="0,8,0,0" />

            <Border Style="{StaticResource Card}" Padding="16,14">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSubscribe" /></Border.GestureRecognizers>
                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" BackgroundColor="#E5F0FF" StrokeShape="RoundRectangle 22">
                        <Image Source="ic_shield.png" WidthRequest="22" HeightRequest="22" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Souscrire une assurance" FontAttributes="Bold" FontSize="17" />
                        <Label Text="Découvrez nos couvertures" Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,14">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnContracts" /></Border.GestureRecognizers>
                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" BackgroundColor="#E8F7F0" StrokeShape="RoundRectangle 22">
                        <Image Source="ic_contracts.png" WidthRequest="22" HeightRequest="22" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Mes contrats" FontAttributes="Bold" FontSize="17" />
                        <Label Text="Détails, échéancier, attestation" Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,14">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnClaim" /></Border.GestureRecognizers>
                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                    <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" BackgroundColor="#FFF1E3" StrokeShape="RoundRectangle 22">
                        <Image Source="ic_clipboard.png" WidthRequest="22" HeightRequest="22" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Déclarer un sinistre" FontAttributes="Bold" FontSize="17" />
                        <Label Text="Faites votre déclaration en 4 étapes" Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
