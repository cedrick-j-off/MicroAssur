<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MicroAssur.Views.ProfilePage"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="14">
            <Label Text="Profil" Style="{StaticResource PageTitle}" />
            <Border WidthRequest="88" HeightRequest="88" StrokeThickness="0" StrokeShape="RoundRectangle 44"
                    BackgroundColor="{StaticResource Primary}" HorizontalOptions="Center" Margin="0,8,0,0">
                <Label x:Name="initialsLabel" TextColor="White" FontSize="32" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label x:Name="nameLabel" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label x:Name="phoneLabel" Style="{StaticResource Muted}" FontSize="16" HorizontalOptions="Center" Margin="0,0,0,10" />

            <Border Style="{StaticResource Card}">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnContracts" /></Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Mes contrats" FontSize="17" />
                    <Label Grid.Column="1" Text="›" FontSize="24" TextColor="{StaticResource TextMuted}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnClaim" /></Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Déclarer un sinistre" FontSize="17" />
                    <Label Grid.Column="1" Text="›" FontSize="24" TextColor="{StaticResource TextMuted}" />
                </Grid>
            </Border>

            <Button Text="Se déconnecter" Style="{StaticResource OutlineButton}" Margin="0,16,0,0" Clicked="OnLogout" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
