<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MicroAssur.Views.SplashPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center" Padding="28,48" Spacing="14">
            <Border BackgroundColor="{StaticResource Chip}" StrokeThickness="0" Padding="12"
                    StrokeShape="RoundRectangle 28" HorizontalOptions="Center">
                <Image Source="logo.png" WidthRequest="220" HeightRequest="190" Aspect="AspectFit" />
            </Border>
            <Label Text="Protégez ce qui compte pour vous"
                   FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextDark}"
                   HorizontalTextAlignment="Center" Margin="0,8,0,8" />
            <Label Text="Une assurance simple, proche de vous."
                   FontSize="16" TextColor="{StaticResource TextMuted}"
                   HorizontalTextAlignment="Center" Margin="0,0,0,12" />
            <Button Text="Commencer" Style="{StaticResource PrimaryButton}" Clicked="OnStart" />
            <Button Text="Se connecter" Style="{StaticResource OutlineButton}" Clicked="OnLogin" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
